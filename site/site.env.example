# Wolfe site contract.
# Copy to site/site.env and replace every placeholder.
# Secrets do not belong in this file. Store a vault item pointer instead.

# --- identity ----------------------------------------------------------
SITE_NAME='Example Site'
SITE_DOMAIN='example.org'
HEALTH_URLS='https://example.org/'

# Public IPv4 of the origin. Use the documentation placeholder until bound.
SERVER_IP='<SERVER_IP>'
SSH_USER='admin'
SSH_PORT=22
ADMIN_CIDR='<ADMIN_CIDR>'

# --- modules -----------------------------------------------------------
# Space-separated. "community" is phpBB with optional MediaWiki.
# Empty means a generic VPS.
MODULES='community'

# --- paths on the origin ----------------------------------------------
WEB_ROOT='/var/www/app'
STATE_DIR='/var/lib/wolfe'
BACKUP_WORK_DIR='/var/lib/wolfe/backup-work'
# Extra paths restic should take, space-separated.
BACKUP_PATHS=''
# Extra database prefixes to dump, space-separated (e.g. WIKI).
# Each PREFIX needs PREFIX_DB_NAME, PREFIX_DB_USER, PREFIX_DB_PASSWORD_ITEM.
EXTRA_DBS=''

# --- primary data ------------------------------------------------------
DB_NAME='app'
DB_USER='app'
DB_PASSWORD_ITEM='<VAULT_NAME>/app-db'

# --- vault and backup --------------------------------------------------
VAULT_NAME='<VAULT_NAME>'
RESTIC_REPOSITORY='s3:https://<S3_ENDPOINT>/<BUCKET>'
RESTIC_PASSWORD_ITEM='<VAULT_NAME>/restic-repo'
AWS_ACCESS_KEY_ID_ITEM='<VAULT_NAME>/restic-s3-key'
AWS_SECRET_ACCESS_KEY_ITEM='<VAULT_NAME>/restic-s3-secret'
AWS_DEFAULT_REGION='auto'

# --- edge --------------------------------------------------------------
# Zone name only. Never a CDN account or zone ID in this template.
DNS_ZONE='example.org'
CDN_PROVIDER='cloudflare'

# --- health ------------------------------------------------------------
# Relative paths that must not return 200 on a public URL after install.
INSTALLER_PATHS=''
# systemd units to report, space-separated. Empty means a small default guess.
SYSTEMD_UNITS=''
# Fail the weekday glance when the newest restic snapshot is older than this.
RESTIC_MAX_AGE_HOURS=36

# Optional. A module or instance script that tools/maintenance will call.
MAINTENANCE_HOOK=''
