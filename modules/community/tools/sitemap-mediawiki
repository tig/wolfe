#!/usr/bin/env bash
usage() {
  cat <<'EOF'
Usage: modules/community/tools/sitemap-mediawiki [--dry-run|--yes]

Write WIKI_DOCROOT/sitemap.xml for publicly readable main-namespace pages.
Skips when WIKI_ENABLED=0.
EOF
}

# shellcheck disable=SC1091
source "$(cd "$(dirname "$0")/../../.." && pwd)/tools/lib/common.sh"
parse_args "$@"
load_site

if ! wiki_enabled; then
  log "wiki disabled; skip."
  exit 0
fi

require_value "WIKI_DOMAIN" "${WIKI_DOMAIN:-}"
require_value "WIKI_DOCROOT" "${WIKI_DOCROOT:-}"
require_value "WIKI_DB_NAME" "${WIKI_DB_NAME:-}"
require_value "WIKI_DB_USER" "${WIKI_DB_USER:-}"
prefix="${WIKI_TABLE_PREFIX:-}"
page_table="${prefix}page"
dest="${WIKI_DOCROOT}/sitemap.xml"
path_prefix="${WIKI_PAGE_PATH:-/wiki/}"

# Main, File, and Category. lastmod is page_touched (revision join is optional).
sql=$(cat <<SQL
SELECT page_title, page_namespace, page_touched
FROM ${page_table}
WHERE page_namespace IN (0, 6, 14)
  AND page_is_redirect = 0
ORDER BY page_touched DESC
LIMIT 50000;
SQL
)

log "sitemap -> $dest"
log "public pages on ${WIKI_DOMAIN}"

require_yes

if [[ "$DRY_RUN" == "1" ]]; then
  log "dry-run SQL:"
  log "$sql"
  log "dry-run: write $dest"
  exit 0
fi

resolve_secret WIKI_DB_PASSWORD WIKI_DB_PASSWORD_ITEM

tmp="$(mktemp)"
printf '%s\n' "$sql" | mysql_cmd "$WIKI_DB_USER" "$WIKI_DB_NAME" "$WIKI_DB_PASSWORD" >"$tmp"

{
  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
  printf '%s\n' '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
  while IFS=$'\t' read -r title ns touched; do
    [[ -z "$title" ]] && continue
    loc="https://${WIKI_DOMAIN}${path_prefix}${title}"
    case "$ns" in
      6) loc="https://${WIKI_DOMAIN}${path_prefix}File:${title}" ;;
      14) loc="https://${WIKI_DOMAIN}${path_prefix}Category:${title}" ;;
    esac
    lastmod="$touched"
    if [[ "$touched" =~ ^[0-9]{14}$ ]]; then
      lastmod="${touched:0:4}-${touched:4:2}-${touched:6:2}T${touched:8:2}:${touched:10:2}:${touched:12:2}Z"
    fi
    printf '  <url><loc>%s</loc><lastmod>%s</lastmod></url>\n' "$loc" "$lastmod"
  done <"$tmp"
  printf '%s\n' '</urlset>'
} >"$dest"

rm -f "$tmp"
log "wrote $dest"
