# Community module fragment.
# Loaded when MODULES contains "community". Merge into site/site.env
# or leave this example in place for dry runs.

FORUM_DOMAIN='forums.example.org'
WIKI_DOMAIN='wiki.example.org'
WIKI_ENABLED=1

FORUM_DOCROOT='/var/www/forum'
WIKI_DOCROOT='/var/www/wiki'

# Core tools use these. The forum is the primary app.
WEB_ROOT='/var/www/forum'
BACKUP_PATHS='/var/www/wiki'
HEALTH_URLS='https://forums.example.org/ https://wiki.example.org/'
INSTALLER_PATHS='install/ mw-config/'
# Set to the absolute path of modules/community/tools/maintenance on the origin.
MAINTENANCE_HOOK=''

FORUM_DB_NAME='phpbb'
FORUM_DB_USER='phpbb'
FORUM_DB_PASSWORD_ITEM='<VAULT_NAME>/forum-db'
FORUM_TABLE_PREFIX='phpbb_'

# Primary dump is the forum.
DB_NAME='phpbb'
DB_USER='phpbb'
DB_PASSWORD_ITEM='<VAULT_NAME>/forum-db'

# Extra dump when the wiki is on. If WIKI_ENABLED=0, set EXTRA_DBS=''
# and BACKUP_PATHS='' as well.
EXTRA_DBS='WIKI'
WIKI_DB_NAME='mediawiki'
WIKI_DB_USER='mediawiki'
WIKI_DB_PASSWORD_ITEM='<VAULT_NAME>/wiki-db'
WIKI_TABLE_PREFIX='wiki_'
WIKI_PAGE_PATH='/wiki/'

# Reports and bans. Conservative defaults. A bound site.env may tighten
# these. It may not loosen them without a handbook note.
SCAM_MAX_AGE_DAYS=7
SCAM_MAX_POSTS=5
FORUM_ADMIN_USERNAME='<FORUM_ADMIN_USERNAME>'
FORUM_BOT_USER='<FORUM_BOT_USER>'
FORUM_BOT_PASSWORD_ITEM='<VAULT_NAME>/forum-bot'
