#!/usr/bin/env bash
usage() {
  cat <<'EOF'
Usage: tools/backup [--dry-run|--yes]
       tools/backup --list
       tools/backup --restore <SNAPSHOT_ID> --target <DIR> [--dry-run|--yes]

Dump databases, restic-backup WEB_ROOT, BACKUP_PATHS, and dumps to
RESTIC_REPOSITORY. Restore only into a target directory. This tool
will not restore over a live docroot.
EOF
}

# shellcheck disable=SC1091
source "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"

ACTION=backup
SNAPSHOT_ID=""
TARGET=""
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --list) ACTION=list; shift ;;
    --restore) ACTION=restore; SNAPSHOT_ID="${2:-}"; shift 2 ;;
    --target) TARGET="${2:-}"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
parse_args "${args[@]:-}"
load_site

require_value "RESTIC_REPOSITORY" "${RESTIC_REPOSITORY:-}"

restic_env() {
  resolve_secret RESTIC_PASSWORD RESTIC_PASSWORD_ITEM
  if [[ -z "${AWS_ACCESS_KEY_ID:-}" && -n "${AWS_ACCESS_KEY_ID_ITEM:-}" ]]; then
    resolve_secret AWS_ACCESS_KEY_ID AWS_ACCESS_KEY_ID_ITEM || true
  fi
  if [[ -z "${AWS_SECRET_ACCESS_KEY:-}" && -n "${AWS_SECRET_ACCESS_KEY_ITEM:-}" ]]; then
    resolve_secret AWS_SECRET_ACCESS_KEY AWS_SECRET_ACCESS_KEY_ITEM || true
  fi
  export RESTIC_REPOSITORY RESTIC_PASSWORD
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
  export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-auto}"
}

if [[ "$ACTION" == "list" ]]; then
  if [[ -z "${RESTIC_PASSWORD:-}" ]]; then
    log "export RESTIC_PASSWORD from ${RESTIC_PASSWORD_ITEM:-the vault}, then re-run --list."
    log "would run: restic snapshots --repo $RESTIC_REPOSITORY"
    exit 0
  fi
  restic_env
  restic snapshots
  exit 0
fi

if [[ "$ACTION" == "restore" ]]; then
  [[ -n "$SNAPSHOT_ID" ]] || die "--restore needs a snapshot id."
  [[ -n "$TARGET" ]] || die "--restore needs --target DIR."
  case "$TARGET" in
    "${WEB_ROOT:-/var/www/app}")
      die "refusing to restore over WEB_ROOT. Pick a scratch directory."
      ;;
  esac
  require_yes
  if [[ "$DRY_RUN" == "1" ]]; then
    log "dry-run: restic restore $SNAPSHOT_ID --target $TARGET"
    exit 0
  fi
  restic_env
  mkdir -p "$TARGET"
  restic restore "$SNAPSHOT_ID" --target "$TARGET"
  log "restored $SNAPSHOT_ID -> $TARGET"
  exit 0
fi

require_yes
work="${BACKUP_WORK_DIR:-/var/lib/wolfe/backup-work}/$(date -u +%Y%m%dT%H%M%SZ)"

if [[ "$DRY_RUN" == "1" ]]; then
  log "dry-run: dump ${DB_NAME:-none} and extra dbs (${EXTRA_DBS:-none}) into $work"
  log "dry-run: restic backup $work ${WEB_ROOT:-} ${BACKUP_PATHS:-}"
  exit 0
fi

need_cmd restic
restic_env
mkdir -p "$work"

if [[ -n "${DB_NAME:-}" ]] && ! is_placeholder "$DB_NAME"; then
  resolve_secret DB_PASSWORD DB_PASSWORD_ITEM
  dump_db "$DB_USER" "$DB_NAME" "$DB_PASSWORD" "$work/primary.sql"
fi

for prefix in ${EXTRA_DBS:-}; do
  name_var="${prefix}_DB_NAME"
  user_var="${prefix}_DB_USER"
  item_var="${prefix}_DB_PASSWORD_ITEM"
  pass_var="${prefix}_DB_PASSWORD"
  require_value "$name_var" "${!name_var:-}"
  require_value "$user_var" "${!user_var:-}"
  resolve_secret "$pass_var" "$item_var"
  dump_db "${!user_var}" "${!name_var}" "${!pass_var}" "$work/${prefix}.sql"
done

paths=("$work")
[[ -n "${WEB_ROOT:-}" ]] && paths+=("$WEB_ROOT")
# shellcheck disable=SC2206
[[ -n "${BACKUP_PATHS:-}" ]] && paths+=($BACKUP_PATHS)

if [[ -f "$SITE_ENV" ]]; then
  cp "$SITE_ENV" "$work/site.env"
fi
if [[ -f "$PINS_ENV" ]]; then
  cp "$PINS_ENV" "$work/pins.env"
fi

restic backup "${paths[@]}"
restic snapshots --latest 1
log "backup work dir $work can be removed after restic reports the snapshot."
